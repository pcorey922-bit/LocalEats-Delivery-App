+package com.equimaps.capacitor_background_geolocation;
+
+/** Monotonic, memory-only acknowledgement lease. No credential or location storage. */
+public final class DutyLease {
+    public static final long INITIAL_MS = 30000;
+    public static final long ACK_MS = 75000; // Shorter than the unchanged 90s server lease.
+    public static final long PULSE_MS = 20000;
+    private long baseline, issuedAt, lastPulse;
+    private long sequence = 0, pending = 0;
+    private boolean acknowledged = false, stopped = false;
+    public DutyLease(long now) { baseline = now; lastPulse = now - PULSE_MS; }
+    public synchronized boolean expired(long now) {
+        return stopped || now < baseline || now - baseline >= (acknowledged ? ACK_MS : INITIAL_MS);
+    }
+    public synchronized long remaining(long now) {
+        return expired(now) ? 0 : (acknowledged ? ACK_MS : INITIAL_MS) - (now - baseline);
+    }
+    public synchronized long pulse(long now) {
+        if (expired(now) || now - lastPulse < PULSE_MS) return 0;
+        lastPulse = now;
+        if (pending == 0) { pending = ++sequence; issuedAt = now; }
+        return pending;
+    }
+    public synchronized boolean acknowledge(long challenge, long now) {
+        if (expired(now) || now < issuedAt || pending == 0 || challenge != pending) return false;
+        // Use native request-issue time, not receipt time: slow JS/network must
+        // never extend the service beyond the server heartbeat's validity.
+        baseline = issuedAt; acknowledged = true; pending = 0;
+        return true;
+    }
+    public synchronized void stop() { stopped = true; }
+}
