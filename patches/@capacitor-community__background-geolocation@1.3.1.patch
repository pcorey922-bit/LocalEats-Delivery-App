+package com.equimaps.capacitor_background_geolocation;
+
+import android.content.*;
+import android.net.*;
+import android.os.*;
+import androidx.core.content.ContextCompat;
+import com.getcapacitor.plugin.util.DutyTrace;
+import java.util.*;
+import java.util.function.Supplier;
+
+/** Read-only power/network observations. Never changes battery policy or stores identifiers. */
+final class DutyPowerMonitor {
+    private final Context context;
+    private final Supplier<Boolean> wakeHeld;
+    private volatile long generation;
+    private volatile boolean listening=false;
+    private volatile ConnectivityManager.NetworkCallback network;
+    DutyPowerMonitor(Context context,Supplier<Boolean> wakeHeld) { this.context=context;this.wakeHeld=wakeHeld; }
+    private Boolean safe(Supplier<Boolean> read) {try{return read.get();}catch(RuntimeException ignored){return null;}}
+    private final BroadcastReceiver receiver=new BroadcastReceiver(){
+        @Override public void onReceive(Context context,Intent intent){
+            String action=intent.getAction();
+            sample(Intent.ACTION_SCREEN_OFF.equals(action)?DutyTrace.Stage.SCREEN_OFF:Intent.ACTION_SCREEN_ON.equals(action)?DutyTrace.Stage.SCREEN_ON:DutyTrace.Stage.POWER);
+        }
+    };
+    synchronized void start(long owner) {
+        stop();generation=owner;
+        IntentFilter filter=new IntentFilter();filter.addAction(Intent.ACTION_SCREEN_OFF);filter.addAction(Intent.ACTION_SCREEN_ON);
+        filter.addAction(PowerManager.ACTION_DEVICE_IDLE_MODE_CHANGED);filter.addAction(PowerManager.ACTION_POWER_SAVE_MODE_CHANGED);
+        if(Build.VERSION.SDK_INT>=33)filter.addAction(PowerManager.ACTION_LOW_POWER_STANDBY_ENABLED_CHANGED);
+        try{ContextCompat.registerReceiver(context,receiver,filter,ContextCompat.RECEIVER_NOT_EXPORTED);listening=true;}catch(RuntimeException ignored){listening=false;}
+        ConnectivityManager manager=(ConnectivityManager)context.getSystemService(Context.CONNECTIVITY_SERVICE);
+        network=new ConnectivityManager.NetworkCallback(){
+            @Override public void onAvailable(Network value){sample(DutyTrace.Stage.NETWORK);}
+            @Override public void onLost(Network value){sample(DutyTrace.Stage.NETWORK);}
+            @Override public void onCapabilitiesChanged(Network value,NetworkCapabilities capabilities){sample(DutyTrace.Stage.NETWORK);}
+        };
+        try{manager.registerDefaultNetworkCallback(network);}catch(RuntimeException ignored){network=null;}
+        sample(DutyTrace.Stage.POWER);
+    }
+    synchronized void stop() {
+        if(listening){try{context.unregisterReceiver(receiver);}catch(RuntimeException ignored){}listening=false;}
+        if(network!=null){try{((ConnectivityManager)context.getSystemService(Context.CONNECTIVITY_SERVICE)).unregisterNetworkCallback(network);}catch(RuntimeException ignored){}network=null;}
+    }
+    void sample(DutyTrace.Stage stage) {
+        long owner=generation;if(owner==0)return;
+        Map<String,Object> state=new LinkedHashMap<>();
+        PowerManager power=(PowerManager)context.getSystemService(Context.POWER_SERVICE);
+        state.put("interactive",safe(()->power.isInteractive()));state.put("deviceIdle",safe(()->power.isDeviceIdleMode()));
+        state.put("powerSave",safe(()->power.isPowerSaveMode()));state.put("ignoringOptimizations",safe(()->power.isIgnoringBatteryOptimizations(context.getPackageName())));
+        state.put("lowPowerStandby",Build.VERSION.SDK_INT>=33?safe(()->power.isLowPowerStandbyEnabled()):null);
+        state.put("lowPowerExempt",Build.VERSION.SDK_INT>=34?safe(()->power.isExemptFromLowPowerStandby()):null);
+        state.put("receiverListening",listening);state.put("networkCallback",network!=null);state.put("wakeHeld",safe(wakeHeld));state.put("transport","UNKNOWN");
+        try{
+            ConnectivityManager manager=(ConnectivityManager)context.getSystemService(Context.CONNECTIVITY_SERVICE);
+            Network current=manager.getActiveNetwork();NetworkCapabilities caps=current==null?null:manager.getNetworkCapabilities(current);
+            state.put("networkValidated",caps!=null&&caps.hasCapability(NetworkCapabilities.NET_CAPABILITY_VALIDATED));
+            state.put("transport",caps==null?"NONE":caps.hasTransport(NetworkCapabilities.TRANSPORT_VPN)?"VPN":caps.hasTransport(NetworkCapabilities.TRANSPORT_WIFI)?"WIFI":caps.hasTransport(NetworkCapabilities.TRANSPORT_CELLULAR)?"CELLULAR":caps.hasTransport(NetworkCapabilities.TRANSPORT_ETHERNET)?"ETHERNET":"OTHER");
+            state.put("dataSaver",manager.getRestrictBackgroundStatus());
+        }catch(RuntimeException ignored){}
+        DutyTrace.power(owner,stage,state,SystemClock.elapsedRealtime());
+    }
+}
