@@ -0,0 +1,15 @@
+package com.equimaps.capacitor_background_geolocation;
+import java.util.concurrent.atomic.AtomicBoolean;
+/** Exactly-one native completion; screen-locked JS timers are not a deadline. */
+public final class DutyRequestGate {
+    public static final long TIMEOUT_MS=15000;
+    public enum Result { ACCEPT, TIMEOUT, IGNORED }
+    private final long started;
+    private final AtomicBoolean terminal=new AtomicBoolean(false);
+    public DutyRequestGate(long started){this.started=started;}
+    public boolean canStart(long now){return !terminal.get()&&withinDeadline(now);}
+    public boolean withinDeadline(long now){return now>=started&&now-started<TIMEOUT_MS;}
+    public Result complete(long now){return !terminal.compareAndSet(false,true)?Result.IGNORED:withinDeadline(now)?Result.ACCEPT:Result.TIMEOUT;}
+    public boolean cancel(){return terminal.compareAndSet(false,true);}
+    public static boolean validHeartbeat(int status,Object online){return status==200&&Boolean.TRUE.equals(online);}
+}
