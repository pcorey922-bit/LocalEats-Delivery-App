# API process: set values in the deployment environment, never commit secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/rocoeats
PORT=3001
NODE_ENV=development
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
LOCALEATS_ADMIN_CLERK_USER_IDS=
CORS_ORIGINS=https://your-web-host.example,https://localhost,capacitor://localhost
# Choose sandbox for local simulation or stripe_test for real provider test calls.
# sandbox is blocked in production. Live Stripe keys are always rejected.
PAYMENT_PROVIDER=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_APP_URL=http://localhost:5173
# Optional mobile push credentials. APNs is sandbox-only in this branch.
FIREBASE_SERVICE_ACCOUNT_JSON=
APNS_PRIVATE_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
# Frontend build environment: artifacts/localeats/.env.local
VITE_CLERK_PUBLISHABLE_KEY=
VITE_API_ORIGIN=
VITE_CLERK_PROXY_URL=
