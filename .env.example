# API process: set values in the deployment environment, never commit secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/rocoeats
PORT=3001
NODE_ENV=development
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
LOCALEATS_ADMIN_CLERK_USER_IDS=
# Optional owner driver exception; IDs must also be in the server administrator allowlist.
ROCOEATS_OWNER_DRIVER_CLERK_USER_IDS=
CORS_ORIGINS=https://your-web-host.example,https://localhost,capacitor://localhost
# Choose stripe_test after securely configuring provider test credentials.
# Local simulation is restricted to automated tests. Live keys are rejected.
PAYMENT_PROVIDER=disabled
ROCOEATS_ORDERING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_APP_URL=http://localhost:5173
# Optional same-origin website hosting; set by the deployable container.
# WEB_DIST_DIR=/app/artifacts/localeats/dist/public
# Optional mobile push credentials. APNs is sandbox-only in this branch.
FIREBASE_SERVICE_ACCOUNT_JSON=
APNS_PRIVATE_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
# Optional runtime web dispatch map. Use a public, browser-restricted key.
# Set both values together. Leave absent to use any legacy frontend build settings.
# ROCOEATS_GOOGLE_MAPS_BROWSER_KEY=
# ROCOEATS_GOOGLE_MAPS_MAP_ID=
# Frontend build environment: artifacts/localeats/.env.local
VITE_CLERK_PUBLISHABLE_KEY=
VITE_API_ORIGIN=
VITE_CLERK_PROXY_URL=
# Public, origin-restricted Maps JavaScript browser key and map ID; never server secrets.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
