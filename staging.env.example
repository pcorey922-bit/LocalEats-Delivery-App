# Copy to .env.staging (gitignored). Enter secrets only on your own machine/host.
# Generate 32 random bytes represented as 64 hex characters; no sample password.
ROCOEATS_DB_PASSWORD=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
LOCALEATS_ADMIN_CLERK_USER_IDS=
# Optional double allowlist for an owner who drives without self-approval.
ROCOEATS_OWNER_DRIVER_CLERK_USER_IDS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_APP_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001
# Keep closed until private staging setup and pricing/operator approvals are verified.
ROCOEATS_ORDERING_ENABLED=false
# Optional public origin-restricted Maps browser settings. Owner Google billing required.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
